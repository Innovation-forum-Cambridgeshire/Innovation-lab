// Innovation Lab dev container.
//
// This builds its own image from the Dockerfile beside it, rather than pulling
// a published one. It used to pull, on the reasoning that a copy drifts and a
// reference does not -- sound reasoning that still failed, for a reason outside
// it: the published image lives in a private GHCR package, so `devpod up` on
// this repository died at the pull with "UNAUTHORIZED: authentication required"
// before any of it mattered.
//
// Building takes about a minute and a half on a first create, once. After that
// the layers are cached and creates are as quick as pulling would have been.
//
// The Dockerfile is GENERATED from Public_Challenge, which holds the real
// definition, and says so in its first line. Editing it here loses the edit on
// the next sync.
//
// It expects the Public_Challenge data tier to be running on the SAME machine.
// See the "Data" section of the root README for what that means and how to
// start it.
{
  "name": "Innovation Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // host.docker.internal is how a container reaches a service published on the
  // host. host-gateway makes it resolve on Linux too, where it is not built in.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  "containerEnv": {
    // The Public_Challenge data tier publishes these on the host. Its own
    // containers are on a different compose network, so the lab reaches them
    // through the host rather than by service name.
    "ACME_PG_HOST": "host.docker.internal",
    "ACME_PG_PORT": "12864",
    "ACME_REDIS_HOST": "host.docker.internal",
    "ACME_REDIS_PORT": "12865",
    "ACME_MINIO_HOST": "host.docker.internal",
    "ACME_MINIO_API_PORT": "12866",
    "ACME_MINIO_UI_PORT": "12867",
    "PGHOST": "host.docker.internal",
    "PGPORT": "12864",
    "PGUSER": "acme",
    "PGPASSWORD": "acme_dev_only",
    "PGDATABASE": "acme_sad"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "ckolkman.vscode-postgres",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        // The image builds its environment at /opt/lab-venv, outside any
        // bind-mounted workspace, so host and container never share one.
        "python.defaultInterpreterPath": "/opt/lab-venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },

  "remoteUser": "vscode"
}
